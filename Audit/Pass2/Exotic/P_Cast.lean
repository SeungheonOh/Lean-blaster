import Blaster
#blaster [∀ (h : Nat = Nat) (x : Nat), cast h x = x]
#blaster [∀ (h : Nat = Nat) (x : Nat), cast h x ≠ x]
#blaster [∀ (n m : Nat) (h : n = m) (x : Fin n), (h ▸ x).val = x.val]
#blaster [∀ (α β : Type) (h : α = β) (a : α) (b : β), cast h a = b]
#blaster [∀ (α β : Type) (h : α = β) (a b : α), cast h a = cast h b → a = b]
#blaster [∀ (α : Type) (h : α = Nat) (a : α), cast h a = 0]
#blaster [∀ (h : Nat = Int), False]
#blaster [(Nat = Int) → False]
#blaster [(Nat = Bool) → False]
#blaster [(Bool = Prop) → False]
#blaster [(Unit = Bool) → False]
#blaster [∀ (h : Bool = Unit), cast h true = cast h false]
#blaster [∀ (h : Bool = Unit), cast h true ≠ cast h false]
#blaster [∀ (x : Nat) (y : Int), HEq x y → False]
#blaster [∀ (x y : Nat), HEq x y → x = y]
#blaster [∀ (x y : Nat), HEq x y]
#blaster [∀ (x : Bool) (y : Unit), ¬ HEq x y]
#blaster [∀ (s : {n : Nat // n > 3}), s.val > 3]
#blaster [∀ (s : {n : Nat // n > 3}), s.val > 4]
#blaster [∀ (s : Σ n : Nat, Fin (n+1)), s.1 ≥ 0]
#blaster [∀ (s : (n : Nat) × Nat), s.1 = s.2]
#blaster [∀ (s : (_ : Nat) ×' Nat), s.1 = s.2]
#blaster [∀ (v : Vector Nat 3), v.size = 3]
#blaster [∀ (v : Vector Nat 3), v.toArray.size = 3]
#blaster [∀ (v : Vector Nat 3), v.toArray.size = 4]
#blaster [∀ (n : Nat) (v : Vector Nat n), v.toArray.size = n]
#blaster [∀ (n : Nat) (v : Vector Nat n), v.toArray.size = n + 1]
#blaster [∀ (a : Array Nat), a.size = a.toList.length]
#blaster [∀ (a : Array Nat), a.size ≠ a.toList.length]
#blaster [(#[1,2,3] : Array Nat).size = 3]
#blaster [(#[1,2,3] : Array Nat).size = 4]
#blaster [(#[1,2,3] : Array Nat) ≠ #[1,2]]
#blaster [(#[1,2,3] : Array Nat)[1]! = 2]
#blaster [(#[1,2,3] : Array Nat)[5]! = 0]
#blaster [(#[1,2,3] : Array Nat)[5]! = 1]
