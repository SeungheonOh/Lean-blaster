import Blaster
open Classical
#blaster [∀ p : Prop, p ∨ ¬p]
#blaster [∀ (b : Bool), (@ite Nat (b = true) (Classical.propDecidable _) 1 2) = (if b then 1 else 2)]
#blaster [∀ (b : Bool), (@ite Nat (b = true) (Classical.propDecidable _) 1 2) ≠ (if b then 1 else 2)]
#blaster [∀ (x : Nat), (@decide (x = 3) (Classical.propDecidable _)) = (x == 3)]
#blaster [∀ (x : Nat), (@decide (x = 3) (Classical.propDecidable _)) ≠ (x == 3)]
#blaster [(Classical.choice ⟨(0:Nat)⟩ : Nat) = Classical.choice ⟨1⟩]
#blaster [(Classical.choice ⟨(0:Nat)⟩ : Nat) ≠ Classical.choice ⟨1⟩]
#blaster [(Classical.choice ⟨(0:Nat)⟩ : Nat) = 0]
#blaster [Classical.choose (⟨0, rfl⟩ : ∃ n : Nat, n = 0) = 0]
#blaster [Classical.choose (⟨0, rfl⟩ : ∃ n : Nat, n = 0) ≠ 0]
#blaster [Classical.choose (⟨0, trivial⟩ : ∃ _ : Nat, True) = Classical.choose (⟨1, trivial⟩ : ∃ _ : Nat, True)]
#blaster [Classical.choose (⟨0, trivial⟩ : ∃ _ : Nat, True) ≠ Classical.choose (⟨1, trivial⟩ : ∃ _ : Nat, True)]
#blaster [Classical.choose (⟨0, trivial⟩ : ∃ _ : Nat, True) = 0]
#blaster [Classical.epsilon (fun n : Nat => n = 5) = 5]
#blaster [Classical.epsilon (fun n : Nat => n = 5) ≠ 5]
#blaster [(@default Nat (Classical.inhabited_of_nonempty ⟨5⟩)) = 5]
#blaster [∀ (x : Nat), (if x = 3 then 1 else 2) = @ite Nat (x = 3) (Classical.propDecidable _) 1 2]
#blaster [∀ p q : Prop, (p ↔ q) → p = q]
#blaster [∀ p q : Prop, (p ↔ q) → p ≠ q]
#blaster [∃ p : Prop, p ≠ True ∧ p ≠ False]
#blaster [True = (1 = 1)]
#blaster [True ≠ (1 = 1)]
#blaster [∀ b : Bool, decide (b = true) = b]
#blaster [∀ b : Bool, (b : Prop) = (b = true)]
#blaster [∀ b : Bool, b.toNat ≤ 1]
#blaster [∀ b : Bool, b.toNat = 2]
#blaster [∀ (p : Prop), (p = True) ∨ (p = False)]
#blaster [∀ (p : Prop), (p = True) ∧ (p = False)]
#blaster [∀ (p : Prop), p = ¬¬p]
#blaster [∀ (p : Prop) [Decidable p], (decide p = true) = p]
#blaster [(1 = 1) = (2 = 2)]
#blaster [(1 = 2) = (2 = 3)]
#blaster [(1 = 2) ≠ (2 = 3)]
#blaster [∀ (x : Nat), (x = 3) ≠ (3 = x)]
#blaster [∀ (f : Prop → Nat), f True = f (1 = 1)]
#blaster [∀ (f : Prop → Nat), f True ≠ f (1 = 1)]
#blaster [∀ (f : Prop → Nat) (x : Nat), f (x = 1) = f (1 = x)]
#blaster [∀ (f : Prop → Nat) (x : Nat), f (x = 1) ≠ f (1 = x)]
#blaster [∀ (f : Prop → Nat) (p q: Prop), (p ↔ q) → f p = f q]
#blaster [∀ (f : Prop → Nat) (p q: Prop), (p ↔ q) → f p ≠ f q]
#blaster [∀ (f : Bool → Nat) (p q: Prop) [Decidable p] [Decidable q], (p ↔ q) → f (decide p) = f (decide q)]
