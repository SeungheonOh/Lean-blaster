import Blaster
import PlutusCore.Integer
import PlutusCore.List
import PlutusCore.Bitwise
import PlutusCore.Cbor.Basic

/-! Kernel-checked proofs generated by Blaster for statements of PlutusCoreBlaster.

Each `blaster_theorem` asks Blaster to prove the statement, reconstructs a proof term and
adds it as a theorem after kernel checking. `#print axioms` shows that no `sorryAx` (or
`Lean.ofReduceBool`) is involved.
-/

open PlutusCore.Integer PlutusCore.List PlutusCore.Bitwise PlutusCore.Cbor PlutusCore.Cbor.CborInternal

namespace BlasterRecon

/-- Same as in `PlutusCore/Bitwise/Lemmas.lean`. -/
def Except.isError (e : Except ε α) : Bool := not (Except.isOk e)

/-! ## Integer builtins (cf. `PlutusCore/Integer/Lemmas.lean`) -/

blaster_theorem divide_add_mod : ∀ (x y d m : Integer),
  divideInteger x y = pure d → modInteger x y = pure m → addInteger (multiplyInteger d y) m = x

blaster_theorem quotient_add_remainder : ∀ (x y q r : Integer),
  quotientInteger x y = pure q → remainderInteger x y = pure r → addInteger (multiplyInteger q y) r = x

blaster_theorem divideInteger_zero : ∀ (x : Integer), divideInteger x 0 = throw "divideInteger: division by zero"

blaster_theorem lessThanEqualsInteger_rfl : ∀ (x y : Integer), lessThanEqualsInteger x y = (x ≤ y)

blaster_theorem equalsInteger_iff_eq : ∀ (x y : Integer), equalsInteger x y ↔ x = y

/-! ## List builtins (cf. `PlutusCore/List/Lemmas.lean`) -/

blaster_theorem chooseList_empty : ∀ (xs : List Nat) (t1 t2 : Int),
  List.isEmpty xs → UPLC.chooseList xs t1 t2 = t1

blaster_theorem chooseList_not_empty : ∀ (xs : List Nat) (t1 t2 : Int),
  ¬ List.isEmpty xs → UPLC.chooseList xs t1 t2 = t2

blaster_theorem caseList_not_empty : ∀ (n : Int) (f : Nat → List Nat → Int) (x : Nat) (xs : List Nat),
  UPLC.caseList n f (x :: xs) = f x xs

/-! ## Bitwise builtins (cf. `PlutusCore/Bitwise/Lemmas.lean`) -/

blaster_theorem integerToByteString_neg_w : ∀ (e : Bool) (w n : Integer), w < 0 →
  integerToByteString e w n = .error "integerToByteString: negative length argument"

blaster_theorem integerToByteString_high_w : ∀ (e : Bool) (w n : Integer), w > 8192 →
  integerToByteString e w n = .error "integerToByteString: requested length is too long (maximum is 8192 bytes)"

blaster_theorem integerToByteString_w_bounds_err : ∀ (e : Bool) (w n : Integer), w < 0 ∨ w > 8192 →
  (integerToByteString e w n |> Except.isError)

blaster_theorem integerToByteString_neg_n : ∀ (e : Bool) (w n : Integer), 0 ≤ w → w ≤ 8192 → n < 0 →
  integerToByteString e w n = .error "integerToByteString: cannot convert negative Integer"

-- NOTE: left as `sorry` in `PlutusCore/Bitwise/Lemmas.lean`
blaster_theorem integerToByteString_n_bounds_err : ∀ (e : Bool) (w n : Integer), n < 0 ∨ n ≥ 2 ^ 65536 →
  (integerToByteString e w n |> Except.isError)

blaster_theorem replicateByte_zero_l : ∀ (b : Integer), 0 ≤ b → b ≤ 255 → replicateByte 0 b = .ok ""

/-! ## CBOR encoding (cf. `PlutusCore/Cbor/Tests.lean`) -/

blaster_theorem encode_example_1 : splitToChunks "" = []

blaster_theorem encode_nil : encodeData (.List []) = some "\x80"

blaster_theorem encode_singleton_ne_none : encodeData (.List [.I 1]) ≠ none

#print axioms divide_add_mod
#print axioms integerToByteString_n_bounds_err
#print axioms encode_nil

end BlasterRecon
