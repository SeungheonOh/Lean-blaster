import Lean
import Blaster.Optimize.Telescope
import Blaster.Reconstruct.Types
import Blaster.Reconstruct.Lemmas
import Blaster.Reconstruct.Match

open Lean Meta Blaster.Optimize

namespace Blaster.Reconstruct

/-! # Building equality evidence during optimization

The optimizer is a stack machine (see `Blaster.Optimize.optimizeExprAux`). Each frame waiting
for the optimized form `v` of some expression `e` also receives evidence `pf : EqPf` that `e = v`.
This module provides the operations used by the stack machine to build such evidence, i.e.,
transitivity, congruence and proof obligations (holes) for rewrites that are not justified yet.

All the operations are no-ops returning `EqPf.unknown` when tracking is disabled, such that
optimization without proof reconstruction does not incur any overhead.
-/

/-- Return `true` when proof terms must be tracked during optimization. -/
@[always_inline, inline]
def isTracking : TranslateEnvT Bool := return (← get).recon.tracking

/-- Set proof tracking flag to `b`. -/
@[always_inline, inline]
def setTracking (b : Bool) : TranslateEnvT Unit :=
  modify fun env => { env with recon.tracking := b }

@[always_inline, inline]
private def incExplicit : TranslateEnvT Unit :=
  modify fun env => { env with recon.nbExplicit := env.recon.nbExplicit + 1 }

/-- Run `f` in the optimizer's local context and return `none` on any error. -/
@[always_inline, inline]
def tryInLocalContext (f : TranslateEnvT α) : TranslateEnvT (Option α) := do
  try withLocalContext (some <$> f)
  catch _ => return none

/-- Return `true` if `e` is a proof obligation generated by `mkHole`. -/
def isHole? (e : Expr) : Option Nat :=
  match e with
  | .mdata d _ => match d.find holeKey with
                  | some (.ofNat n) => some n
                  | _ => none
  | _ => none

/-- Return `true` if `e` is a fallback region (see `fallbackKey`). -/
def isFallback (e : Expr) : Bool :=
  match e with
  | .mdata d _ => d.getBool fallbackKey
  | _ => false

/-- Return `true` if `e` contains at least one proof obligation. -/
def hasHoles (e : Expr) : Bool :=
  (e.find? fun s => (isHole? s).isSome).isSome

/-- Mark `p` as a fallback region when it contains proof obligations (see `fallbackKey`). -/
def mkFallback (p : Expr) : Expr :=
  if hasHoles p then mkMData (KVMap.empty.insert fallbackKey (.ofBool true)) p else p

/-- Return a short description of the head symbol of `e` (used to label proof obligations). -/
def headSymbol (e : Expr) : String :=
  match e.consumeMData.getAppFn with
  | .const n _ => n.toString
  | .lam .. => "lambda"
  | .forallE _ t _ _ => if t.isProp then "forall" else "forall"
  | .fvar .. => "fvar"
  | .proj n i _ => s!"{n}.{i}"
  | .sort .. => "sort"
  | .lit .. => "lit"
  | _ => "other"

/-- Create a proof obligation for `lhs = rhs`.
    Return `EqPf.defeq` when `lhs` and `rhs` are structurally equal and `EqPf.unknown` when
    the equality type cannot be constructed (e.g., ill-typed intermediate expressions).
-/
def mkHole (lhs rhs : Expr) (kind : HoleKind) (label : String) : TranslateEnvT EqPf := do
  if lhs == rhs then return .defeq
  let some eqType ← tryInLocalContext (mkEq lhs rhs) | return .unknown
  let idx := (← get).recon.holes.size
  let label := s!"{kind}:{label}:{headSymbol lhs}"
  modify fun env => { env with recon.holes := env.recon.holes.push { kind, label } }
  let sorryExpr := mkApp2 (mkConst ``sorryAx [levelZero]) eqType (toExpr true)
  return .proof (mkMData (KVMap.empty.insert holeKey (.ofNat idx)) sorryExpr)

/-- Turn `EqPf.unknown` evidence into a proof obligation for `lhs = rhs`. -/
@[always_inline, inline]
def EqPf.close (pf : EqPf) (lhs rhs : Expr) (kind := HoleKind.frame) (label := "") : TranslateEnvT EqPf := do
  match pf.simplify with
  | .unknown =>
      if !(← isTracking) then return .unknown
      mkHole lhs rhs kind label
  | _ => return pf

/-! ## Balanced transitivity chains

The evidence of a long sequence of rewrites (e.g., the evaluation of a recursive function on concrete
arguments, which may involve tens of thousands of steps) is a chain of `Eq.trans` applications.
Built naively, i.e., `Eq.trans p₁ (Eq.trans p₂ (... pₙ))`, the depth of such a proof term is linear
in the number of steps, which overflows the stack of the kernel type checker and of the recursive
traversals performed on proof terms (e.g., `instantiate`, `abstract` or `Expr.replace`, which are not
protected against stack overflows).

Transitivity chains are instead kept as height-balanced (AVL) trees of `Eq.trans` nodes, whose height
is logarithmic in the number of steps. Each node is annotated with its height (see `chainKey`),
the leaves being the individual rewrite steps (i.e., any other equality proof). Two chains are
concatenated via the standard AVL join, whose cost is proportional to the difference of their heights.
Since `Eq.trans` is associative up to the grouping of the steps, the proof only differs by the order in
which the kernel checks the steps, i.e., the end points of each step are unchanged.
-/

/-- Key used to tag a node of a balanced transitivity chain, i.e.,
    `mdata {blaster.chain := height} (Eq.trans α a b c p q)`.
-/
def chainKey : Name := `blaster.chain

/-- Return the height of the balanced transitivity chain `e` (`0` for a leaf, i.e., a single step). -/
def chainHeight (e : Expr) : Nat :=
  match e with
  | .mdata d _ => match d.find chainKey with
                  | some (.ofNat h) => h
                  | _ => 0
  | _ => 0

/-- Return the components `(u, α, a, b, c, p, q)` of a chain node `mdata _ (Eq.trans.{u} α a b c p q)`. -/
def chainNode? (e : Expr) : Option (Level × Expr × Expr × Expr × Expr × Expr × Expr) :=
  if chainHeight e == 0 then none else
  match e with
  | .mdata _ (.app (.app (.app (.app (.app (.app (.const ``Eq.trans [u]) α) a) b) c) p) q) =>
      some (u, α, a, b, c, p, q)
  | _ => none

/-- Return `(u, α, a, b)` such that `p : @Eq.{u} α a b`. -/
def eqProofEnds (p : Expr) : MetaM (Level × Expr × Expr × Expr) := do
  if let some (u, α, a, _, c, _, _) := chainNode? p then return (u, α, a, c)
  let t ← whnfD (← inferType p)
  let some (α, a, b) := t.eq? | throwError "eqProofEnds: equality proof expected{indentExpr p}"
  let u ← match t.getAppFn with
          | .const _ [u] => pure u
          | _ => getLevel α
  return (u, α, a, b)

/-- Return the chain node `Eq.trans l r` (see `chainKey`). -/
def mkChainNode (l r : Expr) : MetaM Expr := do
  let (u, α, a, b) ← eqProofEnds l
  let (_, _, _, c) ← eqProofEnds r
  let h := max (chainHeight l) (chainHeight r) + 1
  return mkMData (KVMap.empty.insert chainKey (.ofNat h)) (mkApp6 (mkConst ``Eq.trans [u]) α a b c l r)

/-- Return the children of chain node `e`. -/
@[inline] private def chainChildren (e : Expr) : Option (Expr × Expr) :=
  (chainNode? e).map fun (_, _, _, _, _, p, q) => (p, q)

/-- Concatenation of the balanced transitivity chains `l : a = b` and `r : b = c` (AVL join), i.e.,
    the resulting chain has the steps of `l` followed by the steps of `r`, and its height is at most
    `max (chainHeight l) (chainHeight r) + 1`.
-/
partial def joinChains (l r : Expr) : MetaM Expr := do
  let hl := chainHeight l
  let hr := chainHeight r
  if hl > hr + 1 then
    let some (ll, lr) := chainChildren l | mkChainNode l r
    let t ← joinChains lr r
    if chainHeight t ≤ chainHeight ll + 1 then return ← mkChainNode ll t
    let some (tl, tr) := chainChildren t | mkChainNode ll t
    if chainHeight tl ≤ chainHeight tr then
      -- single rotation
      mkChainNode (← mkChainNode ll tl) tr
    else
      -- double rotation
      let some (x, y) := chainChildren tl | mkChainNode ll t
      mkChainNode (← mkChainNode ll x) (← mkChainNode y tr)
  else if hr > hl + 1 then
    let some (rl, rr) := chainChildren r | mkChainNode l r
    let t ← joinChains l rl
    if chainHeight t ≤ chainHeight rr + 1 then return ← mkChainNode t rr
    let some (tl, tr) := chainChildren t | mkChainNode t rr
    if chainHeight tr ≤ chainHeight tl then
      mkChainNode tl (← mkChainNode tr rr)
    else
      let some (x, y) := chainChildren tr | mkChainNode t rr
      mkChainNode (← mkChainNode tl x) (← mkChainNode y rr)
  else
    mkChainNode l r

/-- Same as `mkEqTrans` but the resulting proof is a balanced transitivity chain (see `joinChains`). -/
def mkEqTransBalanced (p q : Expr) : MetaM Expr := do
  if p.isAppOf ``Eq.refl then return q
  if q.isAppOf ``Eq.refl then return p
  joinChains p q

/-- Transitivity: given `p : a = b` and `q : b = c` return evidence for `a = c`. -/
def EqPf.trans (p q : EqPf) : TranslateEnvT EqPf := do
  match p.simplify, q.simplify with
  | .unknown, _ | _, .unknown => return .unknown
  | .defeq, q => return q
  | p, .defeq => return p
  | .proof a, .proof b =>
      match ← tryInLocalContext (mkEqTransBalanced a b) with
      | some r => return .proof r
      | none => return .unknown
  | _, _ => return .unknown

/-- Return `true` when `pf` does not need any proof term. -/
@[always_inline, inline]
def EqPf.isDefEq : EqPf → Bool
  | .defeq => true
  | _ => false

/-- Given evidence `pf : f = g`, return evidence for `f a₁ ... aₙ = g a₁ ... aₙ`. -/
def congrFunArgs (pf : EqPf) (args : Array Expr) : TranslateEnvT EqPf := do
  match pf with
  | .proof p =>
      if args.isEmpty then return pf
      match ← tryInLocalContext (args.foldlM (init := p) fun acc a => mkCongrFun acc a) with
      | some r => return .proof r
      | none => return .unknown
  | .defeq => return .defeq
  | _ => return .unknown

/-- Given an application `f a₁ ... aₙ` in which the argument at position `idx` has just been
    rewritten from `a` to `aᵢ` with evidence `pf : a = aᵢ`, return evidence for
    `f a₁ ... a ... aₙ = f a₁ ... aᵢ ... aₙ`.
    `EqPf.unknown` is returned when the argument at position `idx` has forward dependencies
    (i.e., the motive of the congruence would not be type correct).
-/
def congrArgAt (f : Expr) (args : Array Expr) (idx : Nat) (pf : EqPf) : TranslateEnvT EqPf := do
  match pf with
  | .proof p =>
      let r ← tryInLocalContext do
        let finfo ← getFunInfoNArgs f args.size
        -- the motive is not type correct when the type of another argument depends on the rewritten one
        for h : j in [idx+1:finfo.paramInfo.size] do
          if finfo.paramInfo[j].backDeps.contains idx then return none
        let argType ← inferType args[idx]!
        let motive ← withLocalDeclD `x argType fun x => mkLambdaFVars #[x] (mkAppN f (args.set! idx x))
        -- `mkCongrArg` fails when the result type depends on the rewritten argument
        return some (← mkCongrArg motive p)
      match r with
      | some (some r) => return .proof r
      | _ => return .unknown
  | .defeq => return .defeq
  | _ => return .unknown

/-- Given `let x : t := v; b` such that `v` has been rewritten to `v'` with evidence `pf : v = v'`,
    return evidence for `b[v/x] = b[v'/x]`.
-/
def letValueCongr (n : Name) (t : Expr) (b : Expr) (pf : EqPf) : TranslateEnvT EqPf := do
  match pf with
  | .proof p =>
      match ← tryInLocalContext (mkCongrArg (.lam n t b .default) p) with
      | some r => return .proof r
      | none => return .unknown
  | .defeq => return .defeq
  | _ => return .unknown

/-- Given a projection `s.idx` such that `s` has been rewritten to `s'` with evidence `pf : s = s'`,
    return evidence for `s.idx = s'.idx`.
-/
def projCongr (n : Name) (idx : Nat) (s' : Expr) (pf : EqPf) : TranslateEnvT EqPf := do
  match pf with
  | .proof p =>
      let r ← tryInLocalContext do
        let sType ← inferType s'
        mkCongrArg (.lam `s sType (mkProj n idx (.bvar 0)) .default) p
      match r with
      | some r => return .proof r
      | none => return .unknown
  | .defeq => return .defeq
  | _ => return .unknown

/-- Given `x` a free variable and evidence `pf : b = b'` (in which `x` may occur), return
    evidence for `(fun x => b) = (fun x => b')`.
-/
def funextCongr (x : Expr) (b b' : Expr) (pf : EqPf) : TranslateEnvT EqPf := do
  match pf with
  | .proof p =>
      let r ← tryInLocalContext do
        let xType ← inferType x
        let u ← getLevel xType
        let bType ← inferType b
        let v ← getLevel bType
        let β ← mkLambdaFVars #[x] bType
        let f ← mkLambdaFVars #[x] b
        let g ← mkLambdaFVars #[x] b'
        let h ← mkLambdaFVars #[x] p
        return mkApp5 (mkConst ``funext [u, v]) xType β f g h
      match r with
      | some r => return .proof r
      | none => return .unknown
  | .defeq => return .defeq
  | _ => return .unknown

/-- Return `true` when binder types `t` and `t'` are definitionally equal (bounded check).
    NOTE: the body of a lambda whose binder type has been rewritten to a definitionally equal one
    can be related by `funext`, as the kernel checks binder types up to definitional equality.
-/
def sameDomain (t t' : Expr) : TranslateEnvT Bool := do
  if t == t' then return true
  let r ← tryInLocalContext do
    tryCatchRuntimeEx
      (withCurrHeartbeats <| withTheReader Core.Context (fun ctx => { ctx with maxHeartbeats := 20000 * 1000 }) <|
        withTransparency .default <| isDefEq t t')
      (fun _ => return false)
  return r.getD false

/-- Given a lambda `fun x : t => b` rewritten to `fun x : t' => b'` such that `t` and `t'` are not
    definitionally equal and evidence `pf : b = b'` (with `x : t'`), return `EqPf.lamBody` evidence
    when neither `b` nor `b'` depend on `x`. Otherwise `EqPf.unknown`.
-/
def lamBodyCongr (x : Expr) (b b' : Expr) (pf : EqPf) (allowDep := false) : TranslateEnvT EqPf := do
  let xId := x.fvarId!
  -- NOTE: dependency is allowed when the body has been instantiated with a cast (see `LambdaWaitForType`)
  if !allowDep && (b.containsFVar xId || b'.containsFVar xId) then return .unknown
  let r ← tryInLocalContext do
    let p ← match pf with
            | .defeq => some <$> mkEqRefl b
            | .proof p => pure (some p)
            | _ => pure none
    p.mapM (mkLambdaFVars #[x] ·)
  match r with
  | some (some p) => return .lamBody p
  | _ => return .unknown

/-- Given a forall `∀ x : t, b` such that:
      - `pt : t = t'`
      - `pb : b[x] = b'[x]` (with `x : t'`)
    return evidence for `(∀ x : t, b) = (∀ x : t', b')`.
    Assumes that `x` is a free variable of type `t'`.
-/
def forallCongr (x : Expr) (t t' b b' : Expr) (pt pb : EqPf) : TranslateEnvT EqPf := do
  match pt.simplify, pb.simplify with
  | .unknown, _ | _, .unknown => return .unknown
  | .defeq, .defeq => return .defeq
  | .defeq, .proof p =>
      let r ← tryInLocalContext do
        if !(← isProp b) then
          -- `(∀ x : t, b) = (∀ x : t', b')` with `b` not a proposition
          let u ← getLevel t'
          let v ← getLevel (← inferType b)
          let β ← mkLambdaFVars #[x] b
          let β' ← mkLambdaFVars #[x] b'
          let h ← mkLambdaFVars #[x] p
          return mkApp4 (mkConst ``pi_congr [u, v]) t' β β' h
        let u ← getLevel t'
        let β ← mkLambdaFVars #[x] b
        let β' ← mkLambdaFVars #[x] b'
        let h ← mkLambdaFVars #[x] p
        return mkApp4 (mkConst ``forall_congr [u]) t' β β' h
      match r with
      | some r => return .proof r
      | none => return .unknown
  | .proof p, _ =>
      -- only supported for non-dependent implications between propositions
      let r ← tryInLocalContext do
        let xId := x.fvarId!
        if b.containsFVar xId then return none
        if !(← isProp t') || !(← isProp b) then return none
        let pb ← match pb with
                 | .proof q => pure q
                 | _ => mkEqRefl b
        let h ← mkLambdaFVars #[x] pb
        if b'.containsFVar xId then
          let q₂ ← mkLambdaFVars #[x] b'
          -- NOTE: `implies_dep_congr_ctx {p₁ p₂ q₁} (h₁ : p₁ = p₂) {q₂ : p₂ → Prop} (h₂ : ∀ h, q₁ = q₂ h)`
          return some (mkApp6 (mkConst ``implies_dep_congr_ctx) t t' b p q₂ h)
        else
          return some (mkApp6 (mkConst ``implies_congr_ctx) t t' b b' p h)
      match r with
      | some (some r) => return .proof r
      | _ => return .unknown
  | _, _ => return .unknown

/-- Given a forall `∀ x : t, b` such that:
      - `pt : t = t'` (with `t` and `t'` propositions)
      - the body `b` (with `rawBody` the body with a loose bound variable) has been instantiated with a
        cast of `x : t'` to `t` and rewritten to `b'` with evidence `pb`
    return evidence for `(∀ x : t, b) = (∀ x : t', b')` via `forall_prop_domain_congr`.
-/
def castForallCongr (x : Expr) (t t' rawBody b' : Expr) (pt pb : EqPf) : TranslateEnvT EqPf := do
  let .proof p := pt | return .unknown
  let r ← tryInLocalContext do
    let decl ← x.fvarId!.getDecl
    let q₁ := Expr.lam decl.userName t rawBody .default
    let q₂ ← mkLambdaFVars #[x] b'
    let body := rawBody.instantiate1 (mkApp4 (mkConst ``Blaster.Reconstruct.castProof) t' t (← mkEqSymm p) x)
    let pbody ← match pb with
      | .defeq => mkEqRefl body
      | .proof q => pure q
      | _ => throwError "castForallCongr: unknown evidence"
    let h₂ ← mkLambdaFVars #[x] pbody
    return mkAppN (mkConst ``forall_prop_domain_congr) #[t, t', q₁, q₂, p, h₂]
  match r with
  | some r => return .proof r
  | none => return .unknown

/-- Given an application `f a₁ ... aₙ` such that `pf : lhs = f a₁ ... aₙ` and the argument at position
    `idx` has been rewritten from `orig` to `a'ᵢ` with evidence `pfArg`, return evidence for
    `lhs = f a₁ ... a'ᵢ ... aₙ` (with `args` corresponding to the arguments after the rewrite).
    Rewrites on arguments with forward dependencies are kept pending in an `EqPf.depArgs` evidence
    to be resolved once all arguments have been rewritten (see `resolveDepArgs`).
-/
def addArgEvidence
  (f : Expr) (args : Array Expr) (idx : Nat) (orig : Expr) (pfArg : EqPf) (pf : EqPf) : TranslateEnvT EqPf := do
  match pf with
  | .unknown => return .unknown
  | .depArgs pre pargs =>
      if pfArg.isDefEq then return pf
      return .depArgs pre (pargs.push (idx, orig, pfArg))
  | _ =>
    match pfArg with
    | .defeq => return pf
    | .unknown => return .unknown
    | .proof _ =>
        match ← congrArgAt f args idx pfArg with
        | .unknown => return .depArgs pf #[(idx, orig, pfArg)]
        | r => pf.trans r
    | .lamBody _ | .depArgs .. | .matchAlt _ => return .depArgs pf #[(idx, orig, pfArg)]

/-- Resolve pending dependent rewrites on the arguments of `f a₁ ... aₙ` (see `addArgEvidence`).
    The following applications are currently supported:
      - `Blaster.dite' c t e`: via `dite'_congr` (when the condition has been rewritten).
      - `match` and `casesOn` applications: via the matcher's splitter, when alternatives have been
        rewritten under the match context (see `mkMatchCongr`).
-/
def resolveDepArgs (f : Expr) (args : Array Expr) (pf : EqPf) : TranslateEnvT EqPf := do
  match pf with
  | .depArgs pre pargs =>
      let some r ← tryInLocalContext (resolve pargs) | return .unknown
      match r with
      | some p => pre.trans (.proof p)
      | none => return .unknown
  | _ => return pf

  where
    /-- Return the original argument at position `i` and its evidence. -/
    argPf (pargs : Array (Nat × Expr × EqPf)) (i : Nat) : Expr × EqPf :=
      pargs.foldl (fun acc (j, a, p) => if i == j then (a, p) else acc) (args[i]!, .defeq)

    resolve (pargs : Array (Nat × Expr × EqPf)) : MetaM (Option Expr) := do
      match f with
      | .const ``Blaster.dite' us =>
          -- extra arguments (i.e., function-valued dite') are expected to be unchanged
          if args.size < 4 || pargs.any (fun (i, _, _) => i ≥ 4) then return none
          let (c, .proof hc) := argPf pargs 1 | return none
          let (t, pt) := argPf pargs 2
          let (e, pe) := argPf pargs 3
          let c' := args[1]!
          let some ht ← branchPf pt args[2]! c' | return none
          let some he ← branchPf pe args[3]! (mkNot c') | return none
          let p := mkAppN (mkConst ``Blaster.Reconstruct.dite'_congr us)
                     #[args[0]!, c, args[1]!, t, e, args[2]!, args[3]!, hc, ht, he]
          some <$> (args.extract 4 args.size).foldlM (init := p) fun acc a => mkCongrFun acc a
      | .const _ _ =>
          let lhs := mkAppN f (pargs.foldl (fun acc (i, a, _) => acc.set! i a) args)
          let some app ← matchMatcherApp? lhs (alsoCasesOn := true) | return none
          let firstAlt := app.params.size + 1 + app.discrs.size
          let mut altPfs := #[]
          -- only alternatives are expected to be rewritten
          for (i, _, p) in pargs do
            if (i < firstAlt || i ≥ firstAlt + app.alts.size) && !p.isDefEq then return none
          for i in [firstAlt : firstAlt + app.alts.size] do
            match (argPf pargs i).2 with
            | .defeq => altPfs := altPfs.push none
            | .matchAlt p => altPfs := altPfs.push (some p)
            | _ => return none
          -- NOTE: the congruence is a fallback region, i.e., it is replaced with the coarse proof
          -- obligation `lhs = f args` when one of the obligations of the alternatives is not discharged.
          return some (mkFallback (← mkMatchCongr lhs (args.extract firstAlt (firstAlt + app.alts.size)) altPfs))
      | _ => return none

    /-- Return a proof of `∀ h : τ, b (_ : orig) = b' h` for a dite' branch rewritten to `b'`.
        NOTE: For `EqPf.defeq` and `EqPf.proof`, the kernel only accepts the resulting proof when
        the original and rewritten branch domains are definitionally equal (proof irrelevance).
    -/
    branchPf (pf : EqPf) (b' : Expr) (τ : Expr) : MetaM (Option Expr) := do
      match pf with
      | .lamBody p => return some p
      | .proof p =>
          withLocalDeclD `h τ fun h => do
            mkLambdaFVars #[h] (← mkCongrFun p h)
      | .defeq =>
          withLocalDeclD `h τ fun h => do
            mkLambdaFVars #[h] (← mkEqRefl (mkApp b' h))
      | _ => return none

/-- Return `true` if `e` contains a proof obligation (see `mkHole`). -/
def containsHole (e : Expr) : Bool :=
  (e.find? fun s => (isHole? s).isSome).isSome

/-- Given `c` a proposition rewritten to `True` (resp. `False`) with evidence `pf`, return a proof of
    `c` (resp. `¬ c`) that can be used inside expressions, i.e., without proof obligations.
-/
def constCondProof (c : Expr) (pf : EqPf) (isTrue : Bool) : TranslateEnvT (Option Expr) := do
  match pf with
  | .defeq =>
      return some (if isTrue then mkConst ``True.intro else mkConst ``not_false)
  | .proof p =>
      if !containsHole p then
        return some (mkApp2 (mkConst (if isTrue then ``of_eq_true else ``of_eq_false)) c p)
      decideProof
  | _ => decideProof
  where
    /-- Proof by evaluation when `c` is closed and decidable. -/
    decideProof : TranslateEnvT (Option Expr) := do
      if c.hasFVar || c.hasMVar then return none
      let r ← tryInLocalContext do
        let .some inst ← trySynthInstance (mkApp (mkConst ``Decidable) c) | return none
        let b := toExpr isTrue
        let ok ← tryCatchRuntimeEx
          (withCurrHeartbeats <| withTheReader Core.Context (fun ctx => { ctx with maxHeartbeats := 20000 * 1000 }) <|
             withTransparency .default <| isDefEq (mkApp2 (mkConst ``Decidable.decide) c inst) b)
          (fun _ => return false)
        if !ok then return none
        let refl := mkApp2 (mkConst ``Eq.refl [levelOne]) (mkConst ``Bool) b
        return some (mkApp3 (mkConst (if isTrue then ``of_decide_eq_true else ``of_decide_eq_false)) c inst refl)
      return r.join

/-- Return a proof of `Nonempty t` (used to justify the elimination of unused binders).
    An error is triggered when no such proof can be found.
-/
partial def nonemptyProof (t : Expr) : MetaM Expr := do
  let u ← getLevel t
  -- NOTE: local instances are ignored, i.e., a binder to be eliminated can't justify its own inhabitation.
  let synth (c : Expr) : MetaM (LOption Expr) := do withLCtx (← getLCtx) #[] (trySynthInstance c)
  if let .some inst ← synth (mkApp (mkConst ``Nonempty [u]) t) then return inst
  if let .some inst ← synth (mkApp (mkConst ``Inhabited [u]) t) then
    return mkApp2 (mkConst ``Blaster.Reconstruct.nonempty_of_inhabited [u]) t inst
  match ← whnfR t with
  | .forallE n d b bi =>
      -- function type: constant function returning an element of the (non-dependent) codomain
      if b.hasLooseBVars then throwError "nonemptyProof: dependent function type {t}"
      let nb ← nonemptyProof b
      let v ← getLevel b
      let elem := mkApp2 (mkConst ``Classical.choice [v]) b nb
      return mkApp2 (mkConst ``Nonempty.intro [u]) t (.lam n d elem bi)
  | t' =>
    -- inductive type with a nullary constructor
    let .const n us := t'.getAppFn | throwError "nonemptyProof: no proof for {t}"
    let .inductInfo info ← getConstInfo n | throwError "nonemptyProof: no proof for {t}"
    for ctor in info.ctors do
      let .ctorInfo cinfo ← getConstInfo ctor | continue
      if cinfo.numFields == 0 && t'.getAppNumArgs == cinfo.numParams then
        return mkApp2 (mkConst ``Nonempty.intro [u]) t (mkAppN (mkConst ctor us) t'.getAppArgs)
    -- constructor whose (non-dependent) fields are all inhabited, e.g., `BEq α` or `LT α`
    -- NOTE: recursive types are not considered (to ensure termination).
    if info.isRec then throwError "nonemptyProof: no proof for {t}"
    for ctor in info.ctors do
      let .ctorInfo cinfo ← getConstInfo ctor | continue
      if t'.getAppNumArgs != cinfo.numParams then continue
      let ctorApp := mkAppN (mkConst ctor us) t'.getAppArgs
      let some elem ← (try some <$> fieldsElem ctorApp (← instantiateForall cinfo.type t'.getAppArgs)
                       catch _ => pure none) | continue
      return mkApp2 (mkConst ``Nonempty.intro [u]) t elem
    throwError "nonemptyProof: no proof for {t}"
where
  /-- Apply `f : ∀ fields, T` to an arbitrary element of each (non-dependent) field type. -/
  fieldsElem (f fType : Expr) : MetaM Expr := do
    match ← whnfR fType with
    | .forallE _ d b _ =>
        if b.hasLooseBVars then throwError "nonemptyProof: dependent field"
        let nd ← nonemptyProof d
        let elem := mkApp2 (mkConst ``Classical.choice [← getLevel d]) d nd
        fieldsElem (mkApp f elem) b
    | _ => return f

/-- Return `true` if `type := (∀ x : T, b) = b'` or `(∃ x : T, b) = b'` with `x` unused in `b` and
    `Nonempty T` not provable, i.e., an elimination of an unused binder over a possibly empty type.
    Such rewrites are unsound and are reported separately from reconstruction gaps.
-/
def isUnsoundBinderElim (type : Expr) : MetaM Bool := do
  let some (_, lhs, _) := type.eq? | return false
  let binderType? : Option Expr := match lhs with
    | .forallE _ d b _ => if b.hasLooseBVars then none else some d
    | .app (.app (.const ``Exists _) d) (.lam _ _ b _) => if b.hasLooseBVars then none else some d
    | _ => none
  let some d := binderType? | return false
  if ← isProp d then return false
  try
    discard <| nonemptyProof d
    return false
  catch _ => return true

/-! ## Casting proof arguments

Proof arguments are not rewritten when tracking proof terms (see `skipProofArg`). However, the data they
refer to may have been rewritten (e.g., `Fin.mk v p` with `v` rewritten to `v'`), in which case the proof
no longer has the expected type. Such proofs are cast using the evidence of the rewrites of the data.
-/

/-- Return the pairs of maximal subterms `(a, b)` that differ between `e` and `e'` (up to `n` pairs),
    or `none` when `e` and `e'` do not have the same structure.
-/
partial def diffSubterms (e e' : Expr) (n := 8) : Option (Array (Expr × Expr)) := do
  let rec go (e e' : Expr) (acc : Array (Expr × Expr)) : Option (Array (Expr × Expr)) := do
    if e == e' then return acc
    if acc.size ≥ n then none
    match e, e' with
    | .app f a, .app f' a' =>
        if f.getAppNumArgs == f'.getAppNumArgs && f.getAppFn == f'.getAppFn then go a a' (← go f f' acc)
        else return acc.push (e, e')
    | _, _ => return acc.push (e, e')
  go e e' #[]

/-- Return a proof of `t = t'` built from the cached evidence of the rewrites of the differing
    subterms of `t` and `t'` (only when no proof obligation is involved).
-/
def cachedEqProof (t t' : Expr) : TranslateEnvT (Option Expr) := do
  let some diffs := diffSubterms t t' | return none
  let cache := (← get).recon.proofCache
  let mut cur := t
  let mut proof? : Option Expr := none
  for (a, b) in diffs do
    let some (b', pf) := cache.get? a | return none
    if b' != b then return none
    match pf with
    | .defeq => continue
    | .proof p =>
        if containsHole p then return none
        let some step ← tryInLocalContext do
            let aType ← inferType a
            let motive ← withLocalDeclD `z aType fun z => mkLambdaFVars #[z] (cur.replace fun s => if s == a then some z else none)
            mkCongrArg motive p
          | return none
        cur := cur.replace fun s => if s == a then some b else none
        proof? ← match proof? with
          | none => pure (some step)
          | some q => tryInLocalContext (mkEqTrans q step)
    | _ => return none
  return proof?

/-! ## Proof builders for function propagation over `Blaster.dite'` -/

/-- Return a proof of `dite' c t e x₁ ... xₙ = dite' c (fun h => t h x₁ ... xₙ) (fun h => e h x₁ ... xₙ)`
    with `sort` the dite' sort (i.e., a function type) and `us` its universe levels.
-/
def mkDiteAppProof (sort c t e : Expr) (us : List Level) (xs : Array Expr) : MetaM Expr := do
  let mut sort := sort
  let mut t := t
  let mut e := e
  let mut proof? : Option Expr := none
  for x in xs do
    let .forallE n α b _ ← whnfD sort | throwError "mkDiteAppProof: function type expected"
    let β := Expr.lam n α b .default
    let u ← getLevel α
    let resType := b.instantiate1 x
    let v ← getLevel resType
    let step := mkApp6 (mkConst ``Blaster.Reconstruct.dite'_app [u, v]) α β c t e x
    proof? ← match proof? with
             | none => pure (some step)
             | some p => some <$> mkEqTrans (← mkCongrFun p x) step
    t := .lam `h c (mkApp (mkApp t (.bvar 0)) x) .default
    e := .lam `h (mkNot c) (mkApp (mkApp e (.bvar 0)) x) .default
    sort := resType
  let some p := proof? | throwError "mkDiteAppProof: at least one argument expected"
  let _ := us
  return p

/-- Return a proof of
      `f a₁ ... (dite' c t e) ... aₙ = dite' c (fun h => f a₁ ... (t h) ... aₙ) (fun h => f a₁ ... (e h) ... aₙ)`
    with `idx` the position of the `dite'` argument, `sort` the dite' sort and `retType` the
    type of the application.
-/
def mkApplyDiteProof
  (f : Expr) (args : Array Expr) (idx : Nat) (sort c t e retType : Expr) : MetaM Expr := do
  let g := Expr.lam `x sort (mkAppN f (args.set! idx (.bvar 0))) .default
  let u ← getLevel sort
  let v ← getLevel retType
  return mkAppN (mkConst ``Blaster.Reconstruct.apply_dite' [u, v]) #[sort, retType, g, c, t, e]

/-! ## Match alternatives -/

/-- Given a match alternative `fun params => origBody` optimized to `fun params => optExpr` such that:
      - `hyps` are the equalities `dⱼ = pⱼ` between the discriminants and the patterns of the alternative;
      - `substs` are the pairs `(x, h)` such that pattern variable `x` has been substituted by
        discriminant `d` in `origBody` before optimization, with `h : d = x`;
      - `pf : origBody[d/x] = optExpr`;
    return `EqPf.matchAlt p` with `p : ∀ params hyps, origBody = optExpr`.
    The proof obligations in `pf` (if any) are generated in the local context of the alternative,
    i.e., with `params` and `hyps` available.
-/
def matchAltCongr
  (params hyps : Array Expr) (substs : Array (Expr × Expr)) (origBody optExpr : Expr) (pf : EqPf) :
  TranslateEnvT EqPf := do
  if hyps.any (fun h => optExpr.containsFVar h.fvarId!) then return .unknown
  -- evidence for `origBody = origBody[d/x]`
  let some (substPf, body) ← tryInLocalContext (substsPf origBody) | return .unknown
  let pf ← pf.close body optExpr .frame "matchAlt"
  let pf ← substPf.trans pf
  let r ← tryInLocalContext do
    let p ← match pf with
            | .defeq => mkEqRefl origBody
            | .proof p => pure p
            | _ => throwError "matchAltCongr: unexpected evidence"
    mkLambdaFVars (params ++ hyps) p
  match r with
  | some p => return .matchAlt p
  | none => return .unknown

  where
    substsPf (b : Expr) : MetaM (EqPf × Expr) := do
      let mut cur := b
      let mut pf := EqPf.defeq
      for (x, h) in substs do
        let some (_, d, _) := (← inferType h).eq? | throwError "matchAltCongr: equality expected"
        let next := cur.replaceFVar x d
        if next == cur then continue
        let motive := mkLambda `z .default (← inferType x) (cur.abstract #[x])
        let step ← mkCongrArg motive (← mkEqSymm h)
        match pf with
        | .proof p => pf := .proof (← mkEqTrans p step)
        | _ => pf := .proof step
        cur := next
      return (pf, cur)

/-! ## Rule steps

Rewriting rules may record a justification for the rewrites they perform via `recordStep`.
The stack machine collects the recorded steps after each rule application via `ruleStep` and
chains them. Any gap in the chain is turned into a proof obligation.
-/

/-- Record that `lhs` has been rewritten to `rhs` with `p : lhs = rhs`. -/
@[always_inline, inline]
def recordStep (lhs rhs p : Expr) : TranslateEnvT Unit := do
  if !(← isTracking) then return
  modify fun env => { env with recon.stepLog := env.recon.stepLog.push (lhs, rhs, .proof p) }

/-- Record that `lhs` has been rewritten to `rhs` with `lhs` and `rhs` being definitionally equal. -/
@[always_inline, inline]
def recordDefEq (lhs rhs : Expr) : TranslateEnvT Unit := do
  if !(← isTracking) then return
  modify fun env => { env with recon.stepLog := env.recon.stepLog.push (lhs, rhs, .defeq) }

/-- Same as `recordStep` but the proof is computed lazily only when tracking is enabled.
    Nothing is recorded when the proof cannot be constructed.
-/
@[always_inline, inline]
def recordStepM (lhs rhs : Expr) (p : TranslateEnvT Expr) : TranslateEnvT Unit := do
  if !(← isTracking) then return
  if lhs == rhs then return
  let some p ← tryInLocalContext p | return
  modify fun env => { env with recon.stepLog := env.recon.stepLog.push (lhs, rhs, .proof p) }

/-- Record that `lhs` has been rewritten to `rhs` with `p : lhs' = rhs'` such that `lhs'` (resp. `rhs'`) is
    definitionally equal to `lhs` (resp. `rhs`) with default transparency (e.g., up to matcher reduction).
    The proof is computed lazily and nothing is recorded when the check fails.
-/
@[always_inline, inline]
def recordDefEqHint (lhs rhs : Expr) (p : MetaM Expr) : TranslateEnvT Unit :=
  recordStepM lhs rhs do
    let p ← p
    let eq ← mkEq lhs rhs
    unless ← withTransparency .default (isDefEq (← inferType p) eq) do
      throwError "recordDefEqHint: type mismatch"
    mkExpectedTypeHint p eq

/-- Record that `lhs` has been rewritten to `rhs` with `thm args : lhs = rhs` and return `rhs`.
    This is the main helper used by rewriting rules to justify the rewrites they perform.
-/
@[always_inline, inline]
def withThm (lhs rhs : Expr) (thm : Name) (args : Array Expr) (us : List Level := []) : TranslateEnvT Expr := do
  if (← isTracking) && lhs != rhs then
    modify fun env => { env with recon.stepLog := env.recon.stepLog.push (lhs, rhs, .proof (mkAppN (mkConst thm us) args)) }
  return rhs

/-- Same as `withThm` but with a proof term computed lazily (only when tracking proof terms). -/
@[always_inline, inline]
def withProofM (lhs rhs : Expr) (p : TranslateEnvT Expr) : TranslateEnvT Expr := do
  recordStepM lhs rhs p
  return rhs

/-- Same as `withThm` but for a definitional rewrite. -/
@[always_inline, inline]
def withDefEq (lhs rhs : Expr) : TranslateEnvT Expr := do
  recordDefEq lhs rhs
  return rhs

/-- Return `some p` only when `p` is a proof of `key`, i.e., a hypothesis proof that can safely be used
    in a proof term. This is not always the case as hypothesis keys are kept in normalized form.
-/
def hypProof? (key : Expr) (p : Expr) : TranslateEnvT (Option Expr) := do
  let some t ← tryInLocalContext (inferType p) | return none
  if t == key then return some p
  return none

/-- Same as `withThm` but for a rewrite justified by hypothesis `h : key`, i.e., `thm args h : lhs = rhs`.
    Nothing is recorded when `h` is not a proof of `key` (see `hypProof?`).
-/
@[always_inline, inline]
def withHypThm
  (lhs rhs : Expr) (key : Expr) (h : Expr) (thm : Name) (args : Array Expr) (us : List Level := []) :
  TranslateEnvT Expr := do
  if !(← isTracking) then return rhs
  let some h ← hypProof? key h | return rhs
  withThm lhs rhs thm (args.push h) us

/-- Clear the rewrite steps log. -/
@[always_inline, inline]
def clearSteps : TranslateEnvT Unit := do
  if !(← isTracking) then return
  modify fun env => { env with recon.stepLog := #[] }

/-- Return `true` if `p` is a valid justification for rewriting `a` to `b`. -/
def validStep (a b : Expr) (p : EqPf) : TranslateEnvT Bool := do
  match p with
  | .defeq => return true
  | .proof p =>
      let r ← tryInLocalContext do
        let some (_, a', b') := (← instantiateMVars (← inferType p)).eq? | return false
        if a' == a && b' == b then return true
        withTransparency .instances <| isDefEq a' a <&&> isDefEq b' b
      return r.getD false
  | _ => return false

/-- Return evidence that `lhs = rhs` for a rewrite performed by a rule, using the steps
    recorded since the last call to `clearSteps`. Proof obligations are generated for
    any gap in the recorded chain of rewrites.
-/
def ruleStep (lhs rhs : Expr) (label : String) : TranslateEnvT EqPf := do
  if !(← isTracking) then return .unknown
  if lhs == rhs then return .defeq
  let log := (← get).recon.stepLog
  modify fun env => { env with recon.stepLog := #[] }
  let mut cur := lhs
  let mut pf := EqPf.defeq
  for (a, b, p) in log do
    if cur == rhs then break
    if a == cur then
      -- NOTE: recorded proofs are validated such that a wrong justification only results in a
      -- proof obligation (and not in a kernel rejection of the whole proof).
      if !(← validStep a b p) then continue
      pf ← pf.trans p
      incExplicit
      cur := b
  if cur == rhs then return pf
  pf.trans (← mkHole cur rhs .rule label)

/-- Return evidence for a rewrite that is known to preserve definitional equality. -/
@[always_inline, inline]
def defEqStep : TranslateEnvT EqPf := do
  if !(← isTracking) then return .unknown
  modify fun env => { env with recon.nbDefEq := env.recon.nbDefEq + 1 }
  return .defeq

/-! ## Proof cache -/

/-- Update the proof cache with `a := (b, pf)`. -/
@[always_inline, inline]
def cacheProof (a b : Expr) (pf : EqPf) : TranslateEnvT Unit := do
  if !(← isTracking) then return
  match pf with
  | .defeq | .proof _ => modify fun env => { env with recon.proofCache := env.recon.proofCache.insert a (b, pf) }
  | _ => return

/-- Return `true` if all the free variables in `e` are declared in the optimizer's local context. -/
private def fvarsInScope (e : Expr) : TranslateEnvT Bool := do
  if !e.hasFVar then return true
  let lctx := (← get).optEnv.ctx.ctx
  return !(e.find? fun s => s.isFVar && !lctx.contains s.fvarId!).isSome

/-- Return evidence for a cached rewrite `a ⟶ b`. -/
def cachedProof (a b : Expr) : TranslateEnvT EqPf := do
  if !(← isTracking) then return .unknown
  if a == b then return .defeq
  match (← get).recon.proofCache.get? a with
  | some (b', pf) =>
      if b' == b then
        match pf with
        | .proof p => if ← fvarsInScope p then return pf
        | _ => return pf
  | none => pure ()
  mkHole a b .cache "cache"

end Blaster.Reconstruct
